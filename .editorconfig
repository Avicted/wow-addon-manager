# Matches gofmt for Go, so editors agree with the formatter before it runs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.go,go.mod,Makefile}]
indent_style = tab
indent_size = 4

[{*.yaml,*.yml,*.json,*.md}]
indent_style = space
indent_size = 2

[{Dockerfile,Dockerfile.*}]
indent_style = space
indent_size = 4
